FROM zhangjicmu/ubuntu24_ros:ai_module

# apt/pip 설치를 위해 잠시 root 로 전환
USER root

# 베이스 이미지에 pip/git 이 없으므로 apt 로 먼저 설치
RUN apt-get update && \
    apt-get install -y python3-pip git curl && \
    rm -rf /var/lib/apt/lists/*

# PyTorch (YOLO-World, SAM2 둘 다 필요)
# --ignore-installed: 베이스 이미지에 apt로 깐 numpy(1.26.4)가 pip RECORD 메타데이터 없이
# 설치돼있어 uninstall 시도 시 에러남 (debian 패키지 특성). 새 버전으로 그냥 덮어쓰게 함.
RUN python3 -m pip install --no-cache-dir --break-system-packages --ignore-installed torch torchvision

# sysnav 자체 requirements (numpy, opencv-python-headless, ultralytics, google-genai, Pillow)
COPY src/sysnav_ros2_mvp/requirements.txt /tmp/sysnav_requirements.txt
RUN python3 -m pip install --no-cache-dir --break-system-packages --ignore-installed -r /tmp/sysnav_requirements.txt

# YOLO-World가 open-vocabulary 텍스트 임베딩에 clip을 필요로 함. requirements.txt에 없어서
# 런타임에 ultralytics가 자동설치를 시도하는데, 이 환경 pip는 PEP668(externally-managed)이라
# --break-system-packages 없인 자동설치가 실패함 ("No module named 'clip'" 런타임 에러).
# → 빌드 시점에 미리 설치해서 런타임 자동설치 자체가 안 일어나게 함.
RUN python3 -m pip install --no-cache-dir --break-system-packages "git+https://github.com/ultralytics/CLIP.git"

# SAM2 공식 저장소 (pip 패키지가 없어서 소스 설치)
# --no-build-isolation: 기본값(격리 빌드 venv)이면 이미 설치된 torch/CUDA를 무시하고
# 빌드 의존성 해석 과정에서 통째로(수GB) 재다운로드함. 이미 깔린 torch를 그대로 쓰게 함.
RUN git clone --depth 1 https://github.com/facebookresearch/sam2.git /opt/sam2 && \
    python3 -m pip install --no-cache-dir --break-system-packages --no-build-isolation -e /opt/sam2

# 모델 가중치를 빌드 시점에 미리 받는다 (평가 시 런타임 다운로드 없이 바로 추론).
#
# 예전에는 YOLO 가중치를 `YOLOWorld('/home/docker/.../yolov8x-worldv2.pt')` 처럼 절대경로를
# 넘겨서 받으려 했는데, ultralytics 는 **모델 이름**으로만 자동 다운로드하고 존재하지 않는
# 절대경로를 주면 그 자리에 받아주지 않는다. 게다가 `|| echo "WARN: ... skipped"` 로 감싸둬서
# 실패해도 빌드가 그냥 성공했고, 결국 가중치 없는 이미지가 나갔다. 그러면 런타임에 ultralytics
# 가 인터넷에서 받아오는데, 평가 환경이 오프라인이면 인식이 통째로 죽는다.
# → SAM2 와 똑같이 릴리스 URL 에서 직접 받고, 실패하면 빌드를 세운다(`-f`, `|| echo` 제거).
RUN mkdir -p /home/docker/ai_module/weights && \
    curl -fL -o /home/docker/ai_module/weights/sam2.1_hiera_tiny.pt \
      https://dl.fbaipublicfiles.com/segment_anything_2/092824/sam2.1_hiera_tiny.pt && \
    curl -fL -o /home/docker/ai_module/weights/yolov8x-worldv2.pt \
      https://github.com/ultralytics/assets/releases/download/v8.3.0/yolov8x-worldv2.pt && \
    curl -fL -o /home/docker/ai_module/weights/yolo12s.pt \
      https://github.com/ultralytics/assets/releases/download/v8.3.0/yolo12s.pt

# YOLO-World 의 open-vocabulary 텍스트 임베딩에 쓰는 CLIP 모델(ViT-B/32).
# pip 로 깐 건 CLIP 코드일 뿐이고 모델 가중치는 별개다. 안 받아두면 런타임에
# ultralytics 가 CWD 기준 weights/clip/ 로 338MB 를 받는다 - 오프라인이면 그대로 죽는다.
RUN mkdir -p /home/docker/ai_module/weights/clip && \
    curl -fL -o /home/docker/ai_module/weights/clip/ViT-B-32.pt \
      https://openaipublic.azureedge.net/clip/models/40d365715913c9da98579312b702a82c18be219cc2a73407c4526f58eba950af/ViT-B-32.pt

# 모델 파일이 실제로 있고 크기가 정상인지 확인한다. 위 curl 이 조용히 HTML 오류 페이지를
# 받아오는 경우까지 여기서 걸러서, 가중치 없는 이미지가 다시는 배포되지 않게 한다.
RUN set -e; \
    for f in sam2.1_hiera_tiny.pt:100000000 yolov8x-worldv2.pt:100000000 yolo12s.pt:10000000 clip/ViT-B-32.pt:300000000; do \
      name=${f%:*}; min=${f#*:}; path=/home/docker/ai_module/weights/$name; \
      [ -f "$path" ] || { echo "MISSING: $path"; exit 1; }; \
      sz=$(stat -c%s "$path"); \
      [ "$sz" -ge "$min" ] || { echo "TOO SMALL: $path ($sz bytes)"; exit 1; }; \
      echo "OK $name $sz bytes"; \
    done

# sysnav 소스 복사
COPY src/sysnav_ros2_mvp /home/docker/ai_module/src/sysnav_ros2_mvp

# colcon-core는 setuptools<80을 요구하는데 위 pip install들이 최신(83.x)으로 올려놔서
# ament_python 빌드(setup.py develop --editable)가 "option --editable not recognized"로 깨짐 → 되돌림
RUN python3 -m pip install --no-cache-dir --break-system-packages "setuptools<80"

# sysnav 패키지만 빌드
WORKDIR /home/docker/ai_module
RUN /bin/bash -c "\
    source /opt/ros/jazzy/setup.bash && \
    colcon build --symlink-install --packages-select sysnav"

RUN echo "source /home/docker/ai_module/install/setup.bash" >> /home/docker/.bashrc

# system 컨테이너와 동일한 DDS 를 쓰도록 고정한다.
# 베이스 이미지의 ~/.bashrc 도 CycloneDDS 를 export 하지만 그건 대화형 셸에서만 실행된다
# (Ubuntu 기본 .bashrc 는 비대화형이면 맨 앞에서 즉시 return). `bash -c` 나 `bash -lc` 로
# 띄우면 기본값 FastDDS 로 떨어지는데, 두 컨테이너는 network_mode: host 이면서 ipc 가
# private 이라 /dev/shm 이 분리돼 있다. FastDDS 는 둘을 "같은 호스트"로 보고 공유메모리
# 전송을 골라서, discovery 는 되는데 데이터가 한 건도 안 온다. ENV 로 박아두면 실행
# 방식과 무관하게 보장된다.
ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# 이 이미지를 Docker Hub 에서 받아 단독으로 띄우는 사람을 위한 실행 스크립트.
# docker exec 는 ENTRYPOINT(/ros_entrypoint.sh)를 거치지 않고, 비대화형 셸은 ~/.bashrc 를
# 읽지 않으므로 소싱을 여기서 명시적으로 해준다.
#   docker exec -e GEMINI_API_KEY=<key> -it <container> /home/docker/run_sysnav.sh
RUN printf '%s\n' \
      '#!/bin/bash' \
      'set -e' \
      'source /opt/ros/jazzy/setup.bash' \
      'source /home/docker/ai_module/install/setup.bash' \
      'exec ros2 launch sysnav sysnav.launch.py' \
      > /home/docker/run_sysnav.sh \
    && chmod +x /home/docker/run_sysnav.sh \
    && chown docker:docker /home/docker/run_sysnav.sh

ENV SAM2_CHECKPOINT=/home/docker/ai_module/weights/sam2.1_hiera_tiny.pt
ENV SAM2_MODEL_CFG=configs/sam2.1/sam2.1_hiera_t.yaml
ENV YOLO_WORLD_WEIGHTS=/home/docker/ai_module/weights/yolov8x-worldv2.pt
ENV YOLO12_WEIGHTS=/home/docker/ai_module/weights/yolo12s.pt

# debug 출력 폴더를 미리 만들어 둔다.
# 코드도 기동 시 os.makedirs 로 만들지만(scene_graph_visualizer.py), 이미지에 미리
# 있으면 소유권이 docker 로 확정되고 "폴더가 없다 = 노드가 안 떴다"를 바로 구분할 수 있다.
# viewpoint 파노라마(scene_graph_viewpoints/)가 여기 쌓이고, 관계 검증과 VLM 카운팅이
# 그 파일을 다시 읽어가므로 이 경로는 진단용이 아니라 파이프라인 경로다.
RUN mkdir -p /home/docker/ai_module/debug/scene_graph_viewpoints

RUN chown -R docker:docker /home/docker/ai_module

# 원래 유저로 복귀
USER docker
